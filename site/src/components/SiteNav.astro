---
import LogoIcon from './LogoIcon.astro';
import type { NavGroup, NavLink, NavCta } from '../data/navigation';

interface Props {
  groups: NavGroup[];
  links?: NavLink[];
  ctas: NavCta[];
  activeGroupId?: string | null;
  activePath?: string;
  /** Always-filled nav (doc pages). Landing starts unfilled and fills on scroll. */
  filled?: boolean;
}

const { groups, links = [], ctas, activeGroupId = null, activePath = '', filled = false } = Astro.props;
---

<nav
  class={`nav${filled ? ' filled' : ''}`}
  aria-label="Main navigation"
  data-nav-fill={!filled ? '' : undefined}
  data-nav-autohide={!filled ? '' : undefined}
>
  <div class="nav-inner">
    <a href="/" class="nav-logo"><LogoIcon class="nav-logo-icon" />Farn<span>.</span></a>
    <ul class="nav-links">
      {groups.map((g) => (
        <li><a href={g.href} class={activeGroupId === g.id ? 'active' : ''}>{g.label}</a></li>
      ))}
      {links.map((l) => (
        <li><a href={l.href} class={activePath === l.href ? 'active' : ''}>{l.label}</a></li>
      ))}
    </ul>
    <div class="nav-right">
      <a href="https://github.com/jabopiti/farn-theme" class="nav-icon-link" aria-label="GitHub" target="_blank" rel="noopener noreferrer">
        <i class="ti ti-brand-github"></i>
      </a>
      <button class="nav-theme-toggle" aria-label="Switch to dark mode">
        <i class="ti ti-moon"></i>
      </button>
      {ctas.map((c) => (
        <a href={c.href} class={c.primary ? 'nav-cta' : 'nav-cta nav-cta-ghost'}>{c.label}</a>
      ))}
      <button class="nav-toggle" aria-expanded="false" aria-controls="nav-drawer">
        <i class="ti ti-menu-2"></i>
      </button>
    </div>
  </div>
</nav>

<div class="nav-drawer" id="nav-drawer" role="dialog" aria-modal="true" aria-label="Navigation menu">
  <div class="nav-drawer-header">
    <span class="nav-drawer-logo"><LogoIcon />Farn<span>.</span></span>
    <button class="nav-drawer-close" aria-label="Close menu">
      <i class="ti ti-x"></i>
    </button>
  </div>
  <nav class="nav-drawer-nav">
    {groups.map((g) => (
      <a href={g.href} class={`nav-drawer-link${activeGroupId === g.id ? ' active' : ''}`}>{g.label}</a>
    ))}
    {links.map((l) => (
      <a href={l.href} class={`nav-drawer-link${activePath === l.href ? ' active' : ''}`}>{l.label}</a>
    ))}
  </nav>
  <div class="nav-drawer-actions">
    {ctas.map((c) => (
      <a href={c.href} class={c.primary ? 'nav-drawer-cta' : 'nav-drawer-cta nav-drawer-cta-ghost'}>{c.label}</a>
    ))}
  </div>
</div>
<div class="nav-overlay"></div>

<script>
  import '../scripts/nav.js';
</script>
