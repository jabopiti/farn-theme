    svg.style.aspectRatio = spr.vw + ' / ' + spr.vh;
    svg.style.color = f.color;
    svg.style.transformOrigin = (bxe * 100).toFixed(1) + '% 100%';
    svg.style.setProperty('--d', delay.toFixed(2) + 's');
    var g = document.createElementNS(SVGNS, 'g');
    g.setAttribute('transform', 'translate(' + spr.vw + ' 0) scale(-1 1)');
    var use = document.createElementNS(SVGNS, 'use');
    use.setAttributeNS(XLINK, 'href', '#' + f.sprite);
    use.setAttribute('href', '#' + f.sprite);
    g.appendChild(use); svg.appendChild(g);
    el.appendChild(svg);
    containerEl.appendChild(el);
    return el;
  }

  document.querySelectorAll('[data-fern]').forEach(function(hero){ initHero(hero); });
  function initHero(hero){
  var planes = [];
  var overlayFronds = [];
  var overlayContainer = hero.querySelector('.fern-overlay');
  try {
    PLANES.forEach(function (spec) {
      var planeEl = hero.querySelector(spec.sel);
      var fronds = [];
      spec.fronds.forEach(function (f, i) {
        var delay = spec.baseDelay + i * 0.07;
        if (f.overlay) {
          var el = buildOverlayFrond(overlayContainer, f, delay);
          overlayFronds.push({ el: el, baseRot: -(f.rot || 0),
            phase: (i * 1.7 + spec.baseDelay * 9) % (Math.PI * 2),
            freq: 0.7 + ((i * 37) % 10) / 12,
            mult: 0.7 + ((i * 53) % 10) / 16,
            amp: parseFloat(planeEl.dataset.amp),
            mxK: parseFloat(planeEl.dataset.mx) });
        } else {
          var el = buildFrond(planeEl, f, delay);
          fronds.push({ el: el, baseRot: f.rot || 0,
            phase: (i * 1.7 + spec.baseDelay * 9) % (Math.PI * 2),
            freq: 0.7 + ((i * 37) % 10) / 12,
            mult: 0.7 + ((i * 53) % 10) / 16 });
        }
      });
      planes.push({
        el: planeEl, fronds: fronds,
        amp: parseFloat(planeEl.dataset.amp),
        parY: parseFloat(planeEl.dataset.pary),
        mxK: parseFloat(planeEl.dataset.mx),
        parOffset: 0
      });
    });
  } catch (err) { console.error('Build failed:', err); }

  /* Wind energy model. Anchor offsets exceed the travel budget, so plane
     motion can never pull a stem base into view; fronds rotate around their
     base, so artwork only sways, it never slides. */
  var MX_BUDGET = 26; /* px, < smallest side anchor offset */
  var energy = 0, windT = 0, lastFrame = 0;
  var mx = 0, my = 0, tmx = 0, tmy = 0, lastPX = null, lastPY = null, lastY = window.scrollY;

  function applyParallax() {
    var rect = hero.getBoundingClientRect();
    var vh = window.innerHeight || 1;
    var progress = clamp((vh - rect.top) / (vh + rect.height), 0, 1);
    var offset = (progress - 0.5) * 2;
    planes.forEach(function (pl) { pl.parOffset = -offset * pl.parY; });
  }

  function frame() {
    var now = performance.now();
    var dt = lastFrame ? Math.min(0.05, (now - lastFrame) / 1000) : 0.016;
    lastFrame = now; windT += dt;
    energy *= Math.pow(0.45, dt);
    mx += (tmx - mx) * Math.min(1, dt * 5);
    my += (tmy - my) * Math.min(1, dt * 5);
    var e = Math.pow(clamp(energy, 0, 1), 0.75);
    planes.forEach(function (pl, idx) {
      var gust = Math.sin(windT * 0.5 + idx * 0.7) * 0.3;
      var px = clamp(mx * pl.mxK, -MX_BUDGET, MX_BUDGET);
      var py = pl.parOffset + clamp(my * pl.mxK * 0.3, -MX_BUDGET, MX_BUDGET);
      pl.el.style.transform = 'translate3d(' + px.toFixed(2) + 'px,' + py.toFixed(2) + 'px,0)';
      for (var i = 0; i < pl.fronds.length; i++) {
        var f = pl.fronds[i];
        var wind = Math.sin(windT * f.freq + f.phase) * 0.7 + Math.sin(windT * f.freq * 2.6 + f.phase * 1.3) * 0.3 + gust;
        f.el.style.transform = 'rotate(' + (f.baseRot + wind * pl.amp * f.mult * e).toFixed(3) + 'deg)';
      }
    });
    /* Overlay fronds: same physics as plane-0 but px negated (no scaleX wrapper) */
    if (overlayFronds.length > 0) {
      var pl0 = planes[planes.length - 1];
      var gust0 = Math.sin(windT * 0.5 + (planes.length - 1) * 0.7) * 0.3;
      var px0 = clamp(mx * pl0.mxK, -MX_BUDGET, MX_BUDGET);
      var py0 = pl0.parOffset + clamp(my * pl0.mxK * 0.3, -MX_BUDGET, MX_BUDGET);
      overlayContainer.style.transform = 'translate3d(' + (-px0).toFixed(2) + 'px,' + py0.toFixed(2) + 'px,0)';
      for (var j = 0; j < overlayFronds.length; j++) {
        var of = overlayFronds[j];
        var wov = Math.sin(windT * of.freq + of.phase) * 0.7 + Math.sin(windT * of.freq * 2.6 + of.phase * 1.3) * 0.3 + gust0;
        of.el.style.transform = 'rotate(' + (of.baseRot - wov * of.amp * of.mult * e).toFixed(3) + 'deg)';
      }
    }
    return energy > 0.004 || Math.abs(tmx - mx) > 0.01 || Math.abs(tmy - my) > 0.01;
  }

  var chip = hero.querySelector('.state-chip');
  var replayBtn = hero.querySelector('.btn-replay');
  var introMs = parseInt(hero.dataset.intro || '3000', 10);
  var L = { inView:false, settled:false, raf:null, introTimer:null };
  function setChip(t){ if(chip) chip.textContent = t; }
  function startLoop(){
    if (L.raf || prefersReduced) return;
    var step = function(){
      var keep=false; try { keep = frame(); } catch(err){ console.error('frame', err); }
      if (hero.classList.contains('is-intro') || keep) L.raf = requestAnimationFrame(step);
      else { L.raf = null; if (L.settled) setChip('still'); }
    };
    L.raf = requestAnimationFrame(step);
  }
  function settle(){ hero.classList.remove('is-intro'); hero.classList.add('is-settled'); L.settled=true; setChip('still'); }
  function playIntro(){
    hero.classList.remove('is-settled'); void hero.offsetWidth; hero.classList.add('is-intro');
    L.settled=false; setChip('animating in'); energy=1; startLoop();
    clearTimeout(L.introTimer); L.introTimer=setTimeout(settle, introMs);
  }

  if (prefersReduced || !('IntersectionObserver' in window)) {
    hero.classList.add('is-settled'); L.settled=true; setChip('still');
    if (replayBtn) replayBtn.hidden = true; applyParallax();
  } else {
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(en){
        L.inView = en.isIntersecting;
        if (en.isIntersecting && !L.settled && !hero.classList.contains('is-intro')) playIntro();
      });
    }, { threshold: 0.3 });
    io.observe(hero);
    window.addEventListener('scroll', function(){
      var dy = window.scrollY - lastY; lastY = window.scrollY;
      if (!L.inView) return;
      applyParallax(); energy = clamp(energy + Math.abs(dy)*0.005, 0, 1);
      if (L.settled) setChip('wind'); startLoop();
    }, { passive:true });
    hero.addEventListener('pointermove', function(e){
      var rect = hero.getBoundingClientRect();
      tmx = ((e.clientX-rect.left)/rect.width - 0.5)*2;
      tmy = ((e.clientY-rect.top)/rect.height - 0.5)*2;
      if (lastPX!==null){ var sp=Math.hypot(e.clientX-lastPX,e.clientY-lastPY); energy=clamp(energy+Math.min(0.06,sp*0.0011),0,1); }
      lastPX=e.clientX; lastPY=e.clientY;
      if (L.settled && energy>0.02) setChip('wind'); startLoop();
    });
    hero.addEventListener('pointerleave', function(){ tmx=0; tmy=0; lastPX=null; lastPY=null; startLoop(); });
    window.addEventListener('resize', applyParallax, { passive:true });
    applyParallax();
    if (replayBtn) replayBtn.addEventListener('click', playIntro);
  }
  }
})();
</script>
