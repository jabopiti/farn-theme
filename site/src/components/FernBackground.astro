html.js [data-fern]:not(.is-intro):not(.is-settled) .frond svg.art { opacity:0; }
[data-fern].is-intro .frond svg.art { animation:frond-in 1.0s cubic-bezier(0.22,0.7,0.25,1) both; animation-delay:var(--d,0s); }
@keyframes frond-in { from{opacity:0; transform:scale(0.86)} to{opacity:1; transform:none} }
@media (prefers-reduced-motion:reduce){
  html.js [data-fern] .frond svg.art{opacity:1!important}
}
@media (scripting: none) {
  [data-fern] .frond svg.art { opacity: 1; }
}
