}
[data-theme="dark"] [data-fern] {
  --frond-far:      var(--in3-ash);
  --frond-mid:      var(--in2-slate);
}
[data-fern] .scene { position:absolute; inset:0; pointer-events:none; transform:scaleX(-1); }
