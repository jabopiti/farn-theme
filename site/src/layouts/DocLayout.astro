---
import LogoIcon from '../components/LogoIcon.astro';

interface Props {
  title: string;
  description?: string;
  section?: 'getting-started' | 'foundations' | 'components' | 'none';
}

const { title, description = 'Farn design system documentation', section = 'none' } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';

function isActive(href: string) {
  const norm = href.replace(/\/$/, '') || '/';
  if (norm === '/docs') return path === '/docs' || (path.startsWith('/docs/') && !path.startsWith('/docs/foundations') && !path.startsWith('/docs/components'));
  return path === norm;
}
function isSection(prefix: string) {
  return path === prefix || path.startsWith(prefix + '/');
}

const foundationsLinks = [
  { href: '/docs/foundations/color', label: 'Color' },
  { href: '/docs/foundations/typography', label: 'Typography' },
  { href: '/docs/foundations/spacing', label: 'Spacing' },
];
const componentsLinks = [
  { href: '/docs/components', label: 'Overview' },
  { href: '/docs/components/buttons', label: 'Buttons' },
  { href: '/docs/components/cards', label: 'Cards' },
  { href: '/docs/components/forms', label: 'Forms' },
  { href: '/docs/components/navigation', label: 'Navigation' },
];

const hasSubNav = section !== 'none';
const subNavLinks = section === 'foundations' ? foundationsLinks : section === 'components' ? componentsLinks : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} — Farn</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/fern_icon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..900;1,9..144,300..900&family=Instrument+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
    />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/dist/tabler-icons.min.css" />
    <script is:inline>
      (function () {
        const stored = localStorage.getItem('farn-theme');
        const system = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.setAttribute('data-theme', stored ?? system);
      })();
    </script>
  </head>
  <body>

    <!-- Main nav — always filled on doc pages -->
    <nav class="nav filled" id="nav" aria-label="Main navigation">
      <div class="nav-inner">
        <a href="/" class="nav-logo"><LogoIcon />Farn<span>.</span></a>
        <ul class="nav-links">
          <li><a href="/docs" class={isSection('/docs') ? 'active' : ''}>Docs</a></li>
          <li><a href="/about" class={isActive('/about') ? 'active' : ''}>About</a></li>
        </ul>
        <div class="nav-right">
          <a href="https://github.com/jabopiti/farn-theme" class="github-link" aria-label="GitHub" target="_blank" rel="noopener noreferrer">
            <i class="ti ti-brand-github"></i>
          </a>
          <button class="theme-toggle" id="themeToggle" aria-label="Switch to dark mode">
            <i class="ti ti-moon" id="themeIcon"></i>
          </button>
          <a href="/docs/getting-started" class="nav-cta">Get Started</a>
          <button class="hamburger" id="hamburger" aria-expanded="false" aria-controls="mobileDrawer">
            <i class="ti ti-menu-2" id="hamburgerIcon"></i>
          </button>
        </div>
      </div>
    </nav>

    <!-- Mobile drawer -->
    <div class="mobile-drawer" id="mobileDrawer" role="dialog" aria-modal="true" aria-label="Navigation menu">
      <div class="drawer-header">
        <span class="drawer-logo"><LogoIcon />Farn<span>.</span></span>
        <button class="drawer-close" id="drawerClose" aria-label="Close menu">
          <i class="ti ti-x"></i>
        </button>
      </div>
      <nav class="drawer-nav">
        <a href="/docs" class={`drawer-link${isSection('/docs') ? ' active' : ''}`}>Docs</a>
        <a href="/about" class={`drawer-link${isActive('/about') ? ' active' : ''}`}>About</a>
        {subNavLinks && subNavLinks.map(link => (
          <a href={link.href} class={`drawer-link drawer-sublink${isActive(link.href) ? ' active' : ''}`}>{link.label}</a>
        ))}
      </nav>
      <a href="/docs/getting-started" class="drawer-cta">Get Started</a>
    </div>
    <div class="drawer-overlay" id="drawerOverlay"></div>

    <!-- Sub-nav: structural (foundations / components) or provided via slot (getting-started) -->
    {subNavLinks && (
      <nav class="sub-nav filled section-subnav" id="doc-subnav" aria-label={section === 'foundations' ? 'Foundations navigation' : 'Components navigation'}>
        <div class="sub-nav-inner">
          {subNavLinks.map(link => (
            <a href={link.href} class={`sub-nav-link${isActive(link.href) ? ' active' : ''}`}>{link.label}</a>
          ))}
          <span class="sub-nav-indicator" id="doc-subnav-indicator"></span>
        </div>
      </nav>
    )}
    {section === 'getting-started' && <slot name="subnav" />}

    <!-- Page content -->
    <main class="doc-main">
      <div class="doc-container">
        <slot />
      </div>
    </main>

    <!-- Footer -->
    <footer class="page-footer" data-surface="dark">
      <div class="footer-inner">
        <div class="footer-top">
          <div class="footer-logo"><LogoIcon class="footer-logo-icon" />Farn<span>.</span></div>
          <p class="footer-tagline">A design system — sharp, warm, intellectual.</p>
          <div class="footer-nav">
            <a href="/">Home</a>
            <a href="/docs">Docs</a>
            <a href="/docs/getting-started">Getting Started</a>
            <a href="/docs/foundations/color">Color</a>
            <a href="/docs/components">Components</a>
            <a href="/about">About</a>
            <a href="https://github.com/jabopiti/farn-theme" target="_blank" rel="noopener noreferrer">GitHub</a>
          </div>
        </div>
        <hr class="footer-hr" />
        <div class="footer-bar">
          <p class="footer-copy">© 2026 Jacob Lueg Tiedemann — v0.1.0</p>
          <div class="footer-links">
            <a href="https://jbpt.de" target="_blank" rel="noopener noreferrer">About</a>
            <a href="https://jbpt.de/#contact" target="_blank" rel="noopener noreferrer">Contact</a>
            <a href="https://jbpt.de/legal/" target="_blank" rel="noopener noreferrer">Legal Notice / Impressum</a>
            <a href="https://jbpt.de/privacy/" target="_blank" rel="noopener noreferrer">Data Privacy / Datenschutz</a>
            <a href="https://jbpt.de/accessibility/" target="_blank" rel="noopener noreferrer">Accessibility / Barrierefreiheit</a>
          </div>
        </div>
      </div>
    </footer>

    <script is:inline>
      // ── Theme toggle ───────────────────────────────────────────────────────
      const themeToggle = document.getElementById('themeToggle');
      const themeIcon = document.getElementById('themeIcon');
      function syncThemeIcon() {
        const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
        if (themeIcon) themeIcon.className = isDark ? 'ti ti-sun' : 'ti ti-moon';
        if (themeToggle) themeToggle.setAttribute('aria-label', isDark ? 'Switch to light mode' : 'Switch to dark mode');
      }
      syncThemeIcon();
      themeToggle?.addEventListener('click', () => {
        const next = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        localStorage.setItem('farn-theme', next);
        syncThemeIcon();
      });

      // ── Hamburger / mobile drawer ──────────────────────────────────────────
      const hamburger = document.getElementById('hamburger');
      const hamburgerIcon = document.getElementById('hamburgerIcon');
      const mobileDrawer = document.getElementById('mobileDrawer');
      const drawerOverlay = document.getElementById('drawerOverlay');
      const drawerClose = document.getElementById('drawerClose');

      function openDrawer() {
        mobileDrawer?.classList.add('open');
        drawerOverlay?.classList.add('active');
        hamburger?.setAttribute('aria-expanded', 'true');
        if (hamburgerIcon) hamburgerIcon.className = 'ti ti-x';
        document.body.style.overflow = 'hidden';
      }
      function closeDrawer() {
        mobileDrawer?.classList.remove('open');
        drawerOverlay?.classList.remove('active');
        hamburger?.setAttribute('aria-expanded', 'false');
        if (hamburgerIcon) hamburgerIcon.className = 'ti ti-menu-2';
        document.body.style.overflow = '';
      }
      hamburger?.addEventListener('click', () => mobileDrawer?.classList.contains('open') ? closeDrawer() : openDrawer());
      drawerClose?.addEventListener('click', closeDrawer);
      drawerOverlay?.addEventListener('click', closeDrawer);

      // ── Structural sub-nav indicator (foundations / components) ────────────
      const structuralSubNav = document.getElementById('doc-subnav');
      if (structuralSubNav) {
        const indicator = document.getElementById('doc-subnav-indicator');
        const activeLink = structuralSubNav.querySelector('.sub-nav-link.active');
        if (activeLink && indicator) {
          requestAnimationFrame(() => {
            indicator.style.left = activeLink.offsetLeft + 'px';
            indicator.style.width = activeLink.offsetWidth + 'px';
          });
        }
      }

      // ── Scroll-tracking sub-nav (getting-started anchor nav) ───────────────
      const scrollSubNav = document.querySelector('.sub-nav:not(#doc-subnav)');
      if (scrollSubNav) {
        document.documentElement.style.scrollPaddingTop = 'var(--scroll-offset)';
        const subNavLinks = scrollSubNav.querySelectorAll('.sub-nav-link');
        const indicator = scrollSubNav.querySelector('.sub-nav-indicator');

        function updateIndicator(activeLink) {
          if (activeLink && indicator) {
            indicator.style.left = activeLink.offsetLeft + 'px';
            indicator.style.width = activeLink.offsetWidth + 'px';
          }
        }
        if (subNavLinks[0]) {
          subNavLinks[0].classList.add('active');
          requestAnimationFrame(() => updateIndicator(subNavLinks[0]));
        }
        const sectionObs = new IntersectionObserver(entries => {
          entries.forEach(e => {
            if (e.isIntersecting) {
              subNavLinks.forEach(l => l.classList.remove('active'));
              const link = scrollSubNav.querySelector(`a[href="#${CSS.escape(e.target.id)}"]`);
              if (link) { link.classList.add('active'); updateIndicator(link); }
            }
          });
        }, { threshold: 0.1 });
        subNavLinks.forEach(l => {
          const id = l.getAttribute('href')?.slice(1);
          const el = id ? document.getElementById(id) : null;
          if (el) sectionObs.observe(el);
        });
      }
    </script>
  </body>
</html>

<style is:global>
  /* ── Token imports ────────────────────────────────────────────────── */
  @import '../../../tokens/colors.css';
  @import '../../../tokens/spacing.css';
  @import '../../../tokens/dark-light.css';
  @import '../../../tokens/base.css';
  @import '../styles/site.css';

  /* ── Doc layout ───────────────────────────────────────────────────── */
  body { padding-top: var(--nav-height); }
  html { scroll-padding-top: var(--nav-height); }

  .doc-main { min-height: 100vh; }

  .doc-container {
    max-width: var(--width-content);
    margin: 0 auto;
    padding: var(--space-3xl) var(--space-lg) var(--space-4xl);
  }

  /* ── Drawer extras ────────────────────────────────────────────────── */
  .drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 var(--space-md);
    height: 64px;
    border-bottom: 1px solid var(--color-border-subtle);
  }
  .drawer-logo {
    display: flex;
    align-items: center;
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 800;
    font-variation-settings: 'opsz' 20;
    color: var(--color-text);
    letter-spacing: -0.02em;
    gap: 0;
  }
  .drawer-logo span { color: var(--color-accent); }
  .drawer-close {
    width: 36px; height: 36px;
    border: none; background: transparent; cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    border-radius: var(--radius-md);
    color: var(--color-text-secondary);
    font-size: 20px;
  }
  .drawer-close:hover { background: var(--color-bg-elevated); color: var(--color-text); }
  .drawer-nav { display: flex; flex-direction: column; }
  .drawer-link {
    display: flex; align-items: center;
    height: 52px; padding: 0 var(--space-md);
    font-size: 16px; font-weight: 500;
    color: var(--color-text); text-decoration: none;
    border-bottom: 1px solid var(--color-border-subtle);
    transition: background 120ms ease, color 120ms ease;
  }
  .drawer-link:hover { background: var(--color-bg-elevated); color: var(--color-accent); }
  .drawer-link.active { color: var(--color-accent); font-weight: 600; }
  .drawer-sublink {
    padding-left: calc(var(--space-md) + 16px);
    font-size: 14px;
    color: var(--color-text-secondary);
  }
  .drawer-overlay {
    display: none;
    position: fixed; inset: 0;
    background: rgba(0,0,0,0.4);
    z-index: calc(var(--z-overlay) - 1);
  }
  .drawer-overlay.active { display: block; }

  /* ── Prose typography ─────────────────────────────────────────────── */
  .doc-container h1 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-variation-settings: 'opsz' 72;
    letter-spacing: -0.02em;
    line-height: 1.1;
    color: var(--color-text);
    margin-bottom: var(--space-md);
  }
  .doc-container h2 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-variation-settings: 'opsz' 24;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--color-text);
    margin-top: var(--space-xl);
    margin-bottom: var(--space-sm);
  }
  .doc-container h3 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    font-variation-settings: 'opsz' 20;
    letter-spacing: -0.01em;
    color: var(--color-text);
    margin-top: var(--space-lg);
    margin-bottom: var(--space-xs);
  }
  .doc-container p {
    max-width: var(--width-prose);
    margin-bottom: var(--space-md);
    color: var(--color-text-secondary);
    line-height: 1.7;
  }
  .doc-container code {
    font-family: var(--font-mono);
    font-size: 0.875em;
    background: var(--color-bg-sunken);
    padding: 2px 6px;
    border-radius: var(--radius-sm);
  }
  .doc-container pre {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    background: var(--color-bg-sunken);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-md);
    overflow-x: auto;
    margin-bottom: var(--space-md);
    max-width: var(--width-prose);
    line-height: 1.6;
  }
  .doc-container pre code { background: none; padding: 0; font-size: inherit; }
  .doc-container ul,
  .doc-container ol {
    padding-left: var(--space-md);
    margin-bottom: var(--space-md);
    max-width: var(--width-prose);
    color: var(--color-text-secondary);
  }
  .doc-container li { margin-bottom: var(--space-xs); line-height: 1.6; }
  .doc-container strong { font-weight: 600; color: var(--color-text); }
  .doc-container table {
    width: 100%;
    max-width: var(--width-prose);
    border-collapse: collapse;
    margin-bottom: var(--space-lg);
    font-size: 0.875rem;
  }
  .doc-container th {
    text-align: left;
    padding: var(--space-xs) var(--space-sm);
    background: var(--color-bg-elevated);
    color: var(--color-text);
    font-weight: 600;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    border-bottom: 1px solid var(--color-border);
  }
  .doc-container td {
    padding: var(--space-xs) var(--space-sm);
    color: var(--color-text-secondary);
    border-bottom: 1px solid var(--color-border);
    vertical-align: top;
    line-height: 1.5;
  }
  .doc-container tr:last-child td { border-bottom: none; }
  .doc-container hr {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: var(--space-xl) 0;
    max-width: var(--width-prose);
  }
  .doc-container blockquote {
    border-left: 3px solid var(--color-accent);
    padding: var(--space-xs) 0 var(--space-xs) var(--space-md);
    margin: var(--space-md) 0;
    max-width: var(--width-prose);
  }
  .doc-container blockquote p { color: var(--color-text-secondary); font-style: italic; margin-bottom: 0; }
</style>
