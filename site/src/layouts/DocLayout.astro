---
import LogoIcon from '../components/LogoIcon.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Farn design system documentation' } = Astro.props;
const path = Astro.url.pathname;

function isActive(route: string) {
  if (route === '/getting-started') return path === '/getting-started' || path.startsWith('/getting-started/');
  if (route === '/tokens') return path.startsWith('/tokens/');
  if (route === '/components') return path === '/components' || path.startsWith('/components/');
  return path === route;
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} — Farn</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/fern_icon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..900;1,9..144,300..900&family=Instrument+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
    />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/dist/tabler-icons.min.css" />
    <script is:inline>
      (function () {
        const stored = localStorage.getItem('farn-theme');
        const system = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.setAttribute('data-theme', stored ?? system);
      })();
    </script>
  </head>
  <body>

    <!-- Nav — always filled on doc pages -->
    <nav class="nav filled" id="nav" aria-label="Main navigation">
      <div class="nav-inner">
        <a href="/" class="nav-logo"><LogoIcon />Farn<span>.</span></a>
        <ul class="nav-links">
          <li><a href="/getting-started" class={isActive('/getting-started') ? 'active' : ''}>Getting Started</a></li>
          <li><a href="/tokens/colors" class={isActive('/tokens') ? 'active' : ''}>Colors</a></li>
          <li><a href="/tokens/typography" class={isActive('/tokens/typography') ? 'active' : ''}>Typography</a></li>
          <li><a href="/tokens/spacing" class={isActive('/tokens/spacing') ? 'active' : ''}>Spacing</a></li>
          <li><a href="/components" class={isActive('/components') ? 'active' : ''}>Components</a></li>
        </ul>
        <div class="nav-right">
          <a href="https://github.com/jabopiti/farn-theme" class="github-link" aria-label="GitHub" target="_blank" rel="noopener noreferrer">
            <i class="ti ti-brand-github"></i>
          </a>
          <button class="theme-toggle" id="themeToggle" aria-label="Switch to dark mode">
            <i class="ti ti-moon" id="themeIcon"></i>
          </button>
          <a href="/" class="nav-cta">Docs</a>
          <button class="hamburger" id="hamburger" aria-expanded="false" aria-controls="mobileDrawer">
            <i class="ti ti-menu-2" id="hamburgerIcon"></i>
          </button>
        </div>
      </div>
    </nav>

    <!-- Mobile drawer -->
    <div class="mobile-drawer" id="mobileDrawer" role="dialog" aria-modal="true" aria-label="Navigation menu">
      <div class="drawer-header">
        <span class="drawer-logo"><LogoIcon />Farn<span>.</span></span>
        <button class="drawer-close" id="drawerClose" aria-label="Close menu">
          <i class="ti ti-x"></i>
        </button>
      </div>
      <nav class="drawer-nav">
        <a href="/getting-started" class={`drawer-link${isActive('/getting-started') ? ' active' : ''}`}>Getting Started</a>
        <a href="/tokens/colors" class={`drawer-link${isActive('/tokens') ? ' active' : ''}`}>Colors</a>
        <a href="/tokens/typography" class={`drawer-link${isActive('/tokens/typography') ? ' active' : ''}`}>Typography</a>
        <a href="/tokens/spacing" class={`drawer-link${isActive('/tokens/spacing') ? ' active' : ''}`}>Spacing</a>
        <a href="/components" class={`drawer-link${isActive('/components') ? ' active' : ''}`}>Components</a>
      </nav>
      <a href="/" class="drawer-cta">Docs</a>
    </div>
    <div class="drawer-overlay" id="drawerOverlay"></div>

    <!-- Optional sub-nav (provided by individual pages via slot="subnav") -->
    <slot name="subnav" />

    <!-- Page content -->
    <main class="doc-main">
      <div class="doc-container">
        <slot />
      </div>
    </main>

    <!-- Footer -->
    <footer class="page-footer" data-surface="dark">
      <div class="footer-inner">
        <div class="footer-top">
          <div class="footer-logo"><LogoIcon class="footer-logo-icon" />Farn<span>.</span></div>
          <p class="footer-tagline">A design system — sharp, warm, intellectual.</p>
          <div class="footer-nav">
            <a href="/">Design System</a>
            <a href="/getting-started">Getting Started</a>
            <a href="/">Palette</a>
            <a href="/tokens/colors">Colors</a>
            <a href="/components">Components</a>
            <a href="https://github.com/jabopiti/farn-theme" target="_blank" rel="noopener noreferrer">GitHub</a>
          </div>
        </div>
        <hr class="footer-hr" />
        <div class="footer-bar">
          <p class="footer-copy">© 2026 Jacob Lueg Tiedemann — v0.1.0</p>
          <div class="footer-links">
            <a href="https://jbpt.de" target="_blank" rel="noopener noreferrer">About</a>
            <a href="https://jbpt.de/#contact" target="_blank" rel="noopener noreferrer">Contact</a>
            <a href="https://jbpt.de/legal/" target="_blank" rel="noopener noreferrer">Legal Notice / Impressum</a>
            <a href="https://jbpt.de/privacy/" target="_blank" rel="noopener noreferrer">Data Privacy / Datenschutz</a>
            <a href="https://jbpt.de/accessibility/" target="_blank" rel="noopener noreferrer">Accessibility / Barrierefreiheit</a>
          </div>
        </div>
      </div>
    </footer>

    <script is:inline>
      // Theme toggle
      const themeToggle = document.getElementById('themeToggle');
      const themeIcon = document.getElementById('themeIcon');
      function syncThemeIcon() {
        const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
        if (themeIcon) {
          themeIcon.className = isDark ? 'ti ti-sun' : 'ti ti-moon';
        }
        if (themeToggle) {
          themeToggle.setAttribute('aria-label', isDark ? 'Switch to light mode' : 'Switch to dark mode');
        }
      }
      syncThemeIcon();
      themeToggle?.addEventListener('click', () => {
        const html = document.documentElement;
        const next = html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
        html.setAttribute('data-theme', next);
        localStorage.setItem('farn-theme', next);
        syncThemeIcon();
      });

      // Hamburger / mobile drawer
      const hamburger = document.getElementById('hamburger');
      const hamburgerIcon = document.getElementById('hamburgerIcon');
      const mobileDrawer = document.getElementById('mobileDrawer');
      const drawerOverlay = document.getElementById('drawerOverlay');
      const drawerClose = document.getElementById('drawerClose');

      function openDrawer() {
        mobileDrawer?.classList.add('open');
        drawerOverlay?.classList.add('active');
        hamburger?.setAttribute('aria-expanded', 'true');
        if (hamburgerIcon) hamburgerIcon.className = 'ti ti-x';
        document.body.style.overflow = 'hidden';
      }
      function closeDrawer() {
        mobileDrawer?.classList.remove('open');
        drawerOverlay?.classList.remove('active');
        hamburger?.setAttribute('aria-expanded', 'false');
        if (hamburgerIcon) hamburgerIcon.className = 'ti ti-menu-2';
        document.body.style.overflow = '';
      }

      hamburger?.addEventListener('click', () => {
        const isOpen = mobileDrawer?.classList.contains('open');
        isOpen ? closeDrawer() : openDrawer();
      });
      drawerClose?.addEventListener('click', closeDrawer);
      drawerOverlay?.addEventListener('click', closeDrawer);

      // Sub-nav scroll tracking (runs only when a sub-nav slot is provided)
      const docSubNav = document.querySelector('.sub-nav');
      if (docSubNav) {
        // Expand scroll-padding to clear both nav and sub-nav on this page
        document.documentElement.style.scrollPaddingTop = 'var(--scroll-offset)';
        const docSubNavLinks = docSubNav.querySelectorAll('.sub-nav-link');
        const docIndicator = docSubNav.querySelector('.sub-nav-indicator');

        function updateDocIndicator(activeLink) {
          if (activeLink && docIndicator) {
            docIndicator.style.left = activeLink.offsetLeft + 'px';
            docIndicator.style.width = activeLink.offsetWidth + 'px';
          }
        }

        if (docSubNavLinks[0]) {
          docSubNavLinks[0].classList.add('active');
          requestAnimationFrame(() => updateDocIndicator(docSubNavLinks[0]));
        }

        const sectionObs = new IntersectionObserver(entries => {
          entries.forEach(e => {
            if (e.isIntersecting) {
              docSubNavLinks.forEach(l => l.classList.remove('active'));
              const link = docSubNav.querySelector(`a[href="#${CSS.escape(e.target.id)}"]`);
              if (link) { link.classList.add('active'); updateDocIndicator(link); }
            }
          });
        }, { threshold: 0.1 });

        docSubNavLinks.forEach(l => {
          const id = l.getAttribute('href')?.slice(1);
          const el = id ? document.getElementById(id) : null;
          if (el) sectionObs.observe(el);
        });
      }
    </script>
  </body>
</html>

<style is:global>
  /* ── Farn token imports ──────────────────────────────────────────────── */
  @import '../../../tokens/colors.css';
  @import '../../../tokens/spacing.css';
  @import '../../../tokens/dark-light.css';
  @import '../../../tokens/base.css';
  @import '../styles/site.css';

  /* ── Doc page layout ─────────────────────────────────────────────────── */
  /* body padding pushes all flow content below the fixed nav; sub-nav
     uses position:sticky top:nav-height which only activates on scroll —
     without this padding the sub-nav starts at y:0 and is hidden behind
     the fixed nav until the user scrolls. */
  body { padding-top: var(--nav-height); }

  /* Default scroll offset clears the fixed nav; JS overrides to
     --scroll-offset on pages that also have a sticky sub-nav. */
  html { scroll-padding-top: var(--nav-height); }

  .doc-main {
    min-height: 100vh;
  }

  .doc-container {
    max-width: var(--width-content);
    margin: 0 auto;
    padding: var(--space-3xl) var(--space-lg) var(--space-4xl);
  }

  /* ── Prose typography ────────────────────────────────────────────────── */
  /* Fraunces: font-variation-settings: 'opsz' <size> is mandatory         */
  .doc-container h1 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-variation-settings: 'opsz' 72;
    letter-spacing: -0.02em;
    line-height: 1.1;
    color: var(--color-text);
    margin-bottom: var(--space-md);
  }

  .doc-container h2 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-variation-settings: 'opsz' 24;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--color-text);
    margin-top: var(--space-xl);
    margin-bottom: var(--space-sm);
  }

  .doc-container h3 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    font-variation-settings: 'opsz' 20;
    letter-spacing: -0.01em;
    color: var(--color-text);
    margin-top: var(--space-lg);
    margin-bottom: var(--space-xs);
  }

  .doc-container p {
    max-width: var(--width-prose);
    margin-bottom: var(--space-md);
    color: var(--color-text-secondary);
    line-height: 1.7;
  }

  .doc-container code {
    font-family: var(--font-mono);
    font-size: 0.875em;
    background: var(--color-bg-sunken);
    padding: 2px 6px;
    border-radius: var(--radius-sm);
  }

  .doc-container pre {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    background: var(--color-bg-sunken);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-md);
    overflow-x: auto;
    margin-bottom: var(--space-md);
    max-width: var(--width-prose);
    line-height: 1.6;
  }

  .doc-container pre code {
    background: none;
    padding: 0;
    font-size: inherit;
  }

  .doc-container ul,
  .doc-container ol {
    padding-left: var(--space-md);
    margin-bottom: var(--space-md);
    max-width: var(--width-prose);
    color: var(--color-text-secondary);
  }

  .doc-container li {
    margin-bottom: var(--space-xs);
    line-height: 1.6;
  }

  .doc-container strong {
    font-weight: 600;
    color: var(--color-text);
  }

  .doc-container table {
    width: 100%;
    max-width: var(--width-prose);
    border-collapse: collapse;
    margin-bottom: var(--space-lg);
    font-size: 0.875rem;
  }

  .doc-container th {
    text-align: left;
    padding: var(--space-xs) var(--space-sm);
    background: var(--color-bg-elevated);
    color: var(--color-text);
    font-weight: 600;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    border-bottom: 1px solid var(--color-border);
  }

  .doc-container td {
    padding: var(--space-xs) var(--space-sm);
    color: var(--color-text-secondary);
    border-bottom: 1px solid var(--color-border);
    vertical-align: top;
    line-height: 1.5;
  }

  .doc-container tr:last-child td { border-bottom: none; }

  .doc-container hr {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: var(--space-xl) 0;
    max-width: var(--width-prose);
  }

  .doc-container blockquote {
    border-left: 3px solid var(--color-accent);
    padding: var(--space-xs) 0 var(--space-xs) var(--space-md);
    margin: var(--space-md) 0;
    max-width: var(--width-prose);
  }

  .doc-container blockquote p {
    color: var(--color-text-secondary);
    font-style: italic;
    margin-bottom: 0;
  }
</style>
