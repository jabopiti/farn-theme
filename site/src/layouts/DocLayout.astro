---
import SiteNav from '../components/SiteNav.astro';
import Footer from '../components/Footer.astro';
import { groups, links, ctas } from '../data/navigation';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Farn design system documentation' } = Astro.props;
const path = Astro.url.pathname;
// Normalise trailing slash for matching (root excepted)
const p = path !== '/' && path.endsWith('/') ? path.slice(0, -1) : path;

// Active group derived from data (single source of truth). A path belongs to
// a group if it is the group root, sits under it, or matches one of the group's
// page hrefs (handles any remaining transitional URLs cleanly).
const activeGroup =
  groups.find((g) => p === g.href || p.startsWith(g.href + '/') || g.pages.some((pg) => pg.href === p)) ?? null;

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} — Farn</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/fern_icon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..900;1,9..144,300..900&family=Instrument+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
    />
    <script is:inline>
      (function () {
        const stored = localStorage.getItem('farn-theme');
        const system = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.setAttribute('data-theme', stored ?? system);
      })();
    </script>
  </head>
  <body>

    <!-- Nav + mobile drawer (always filled on doc pages) -->
    <SiteNav {groups} {links} {ctas} activeGroupId={activeGroup?.id} activePath={p} filled={true} />

    <!-- Sub-nav: group navigation for grouped pages; otherwise a page-internal
         TOC supplied by the page via slot="subnav" (standalone long pages). -->
    {activeGroup && activeGroup.pages.length > 1 ? (
      <nav class="sub-nav filled group-nav" aria-label="Section navigation">
        <div class="sub-nav-inner">
          {activeGroup.pages.map((pg) => (
            <a href={pg.href} class={`sub-nav-link${p === pg.href ? ' active' : ''}`}>{pg.label}</a>
          ))}
          <span class="sub-nav-indicator"></span>
        </div>
      </nav>
    ) : (
      <slot name="subnav" />
    )}

    <!-- Page content -->
    <main class="doc-main" id="main-content">
      <div class="doc-container">
        <slot />
      </div>
    </main>

    <!-- Footer -->
    <Footer>
      <a href="/foundations">Foundations</a>
      <a href="/styles">Styles</a>
      <a href="/components">Components</a>
      <a href="/getting-started">Get Started</a>
      <a href="https://github.com/jabopiti/farn-theme" target="_blank" rel="noopener noreferrer">GitHub</a>
    </Footer>

    <script>
      import { initScrollReveal } from '../scripts/scroll-reveal.js';
      import { initSubNavTracker, positionIndicator } from '../scripts/subnav-tracker.js';
      import { initCodeCopy } from '../scripts/code-copy.js';
      import { initTabs } from '../scripts/tabs.js';
      initScrollReveal();
      initCodeCopy();
      initTabs();

      const groupNav = document.querySelector('.sub-nav.group-nav');
      if (groupNav) {
        // Group navigation: the pill marks the active PAGE (static), not scroll.
        // A sticky sub-nav is present, so anchor jumps must clear nav + sub-nav
        // (the page-TOC branch sets this via initSubNavTracker; mirror it here).
        document.documentElement.style.scrollPaddingTop = 'var(--scroll-offset)';
        const active = groupNav.querySelector('.sub-nav-link.active');
        const reposition = () => positionIndicator(groupNav);
        reposition();
        window.addEventListener('resize', reposition);
        // Web fonts load with display=swap, which changes link widths after first
        // paint. Re-settle once they're ready: reposition the pill, and scroll the
        // active link into view only when the bar actually overflows.
        (document.fonts?.ready ?? Promise.resolve()).then(() => {
          reposition();
          if (active && groupNav.scrollWidth > groupNav.clientWidth) {
            active.scrollIntoView({ inline: 'center', block: 'nearest' });
          }
        });
      } else {
        // Page-internal TOC (standalone long pages): keep scroll-spy tracking.
        const subNav = document.querySelector('.sub-nav');
        if (subNav) {
          initSubNavTracker(subNav, {
            threshold: 0.1,
            activateFirst: true,
            setScrollPadding: true,
          });
        }
      }
    </script>
  </body>
</html>

<style is:global>
  /* ── Farn token imports ──────────────────────────────────────────────── */
  @import '../../../tokens/colors.css';
  @import '../../../tokens/typography.css';
  @import '../../../tokens/spacing.css';
  @import '../../../tokens/motion.css';
  @import '../../../tokens/dark-light.css';
  @import '../../../tokens/components.css';
  @import '../../../tokens/component-classes.css';
  @import '../../../tokens/typography-classes.css';
  @import '../../../tokens/layout.css';
  @import '../../../tokens/base.css';
  @import '../styles/site.css';

  /* ── Doc page layout ─────────────────────────────────────────────────── */
  /* body padding pushes all flow content below the fixed nav; sub-nav
     uses position:sticky top:nav-height which only activates on scroll —
     without this padding the sub-nav starts at y:0 and is hidden behind
     the fixed nav until the user scrolls. */
  body { padding-top: var(--nav-height); }

  /* Default scroll offset clears the fixed nav; JS overrides to
     --scroll-offset on pages that also have a sticky sub-nav. */
  html { scroll-padding-top: var(--nav-height); }

  .doc-main {
    min-height: 100vh;
  }

  .doc-container {
    max-width: var(--width-content);
    margin: 0 auto;
    padding: var(--space-3xl) var(--space-lg) var(--space-4xl);
  }

  /* ── Prose typography ────────────────────────────────────────────────── */
  /* Fraunces: font-variation-settings: 'opsz' <size> is mandatory         */
  .doc-container h1 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-variation-settings: 'opsz' 72;
    letter-spacing: -0.02em;
    line-height: 1.1;
    color: var(--color-text);
    margin-bottom: var(--space-md);
  }

  .doc-container h2 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-variation-settings: 'opsz' 24;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--color-text);
    margin-top: var(--space-xl);
    margin-bottom: var(--space-sm);
  }

  .doc-container h3 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    font-variation-settings: 'opsz' 20;
    letter-spacing: -0.01em;
    color: var(--color-text);
    margin-top: var(--space-lg);
    margin-bottom: var(--space-xs);
  }

  .doc-container p {
    max-width: var(--width-prose);
    margin-bottom: var(--space-md);
    color: var(--color-text-secondary);
    line-height: 1.7;
  }

  .doc-container code {
    font-family: var(--font-mono);
    font-size: 0.875em;
    background: var(--color-bg-inset);
    padding: 2px 6px;
    border-radius: var(--radius-sm);
  }

  /* JS-disabled fallback: when code-copy.js hasn't run, <pre> handles its own
     max-width, margin, and positioning. Once the wrapper is inserted these are
     overridden by .code-copy-wrap and .code-copy-wrap > pre below. */
  .doc-container pre {
    position: relative;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    background: var(--color-bg-inset);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-md);
    overflow-x: auto;
    margin-bottom: var(--space-md);
    max-width: var(--width-prose);
    line-height: 1.6;
  }

  /* When code-copy.js wraps <pre> in a positioning div, the wrapper takes over
     max-width/margin/positioning so the button stays fixed during horizontal scroll. */
  .doc-container .code-copy-wrap {
    position: relative;
    max-width: var(--width-prose);
    margin-bottom: var(--space-md);
  }

  .doc-container .code-copy-wrap > pre {
    position: static;
    max-width: none;
    margin-bottom: 0;
  }

  .doc-container pre code {
    background: none;
    padding: 0;
    font-size: inherit;
  }

  .doc-container ul,
  .doc-container ol:not(.breadcrumb) {
    padding-left: var(--space-md);
    margin-bottom: var(--space-md);
    max-width: var(--width-prose);
    color: var(--color-text-secondary);
  }

  .doc-container li {
    margin-bottom: var(--space-xs);
    line-height: 1.6;
  }

  .doc-container strong {
    font-weight: 600;
    color: var(--color-text);
  }

  .doc-container table {
    width: 100%;
    max-width: var(--width-prose);
    border-collapse: collapse;
    margin-bottom: var(--space-lg);
    font-size: 0.875rem;
  }

  .doc-container th {
    text-align: left;
    padding: var(--space-xs) var(--space-sm);
    background: var(--color-bg-panel);
    color: var(--color-text);
    font-weight: 600;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    border-bottom: 1px solid var(--color-border);
  }

  .doc-container td {
    padding: var(--space-xs) var(--space-sm);
    color: var(--color-text-secondary);
    border-bottom: 1px solid var(--color-border);
    vertical-align: top;
    line-height: 1.5;
  }

  .doc-container tr:last-child td { border-bottom: none; }

  .doc-container hr:not([class]) {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: var(--space-xl) 0;
    max-width: var(--width-prose);
  }

  .doc-container blockquote {
    border-left: 3px solid var(--color-accent);
    padding: var(--space-xs) 0 var(--space-xs) var(--space-md);
    margin: var(--space-md) 0;
    max-width: var(--width-prose);
  }

  .doc-container blockquote p {
    color: var(--color-text-secondary);
    font-style: italic;
    margin-bottom: 0;
  }
</style>
