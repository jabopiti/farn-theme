<script is:inline>
// ── Theme ─────────────────────────────────────
const toggle = document.getElementById('themeToggle');
const icon = document.getElementById('themeIcon');
function updateToggleIcon() {
  const theme = document.documentElement.getAttribute('data-theme');
  if (theme === 'dark') { icon.className = 'ti ti-sun'; toggle.setAttribute('aria-label', 'Switch to light mode'); }
  else { icon.className = 'ti ti-moon'; toggle.setAttribute('aria-label', 'Switch to dark mode'); }
}
updateToggleIcon();
toggle.addEventListener('click', () => {
  const next = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
  document.documentElement.setAttribute('data-theme', next);
  localStorage.setItem('farn-theme', next);
  updateToggleIcon();
});
window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
  if (!localStorage.getItem('farn-theme')) {
    document.documentElement.setAttribute('data-theme', e.matches ? 'dark' : 'light');
    updateToggleIcon();
  }
});

// ── View switching ─────────────────────────────
const nav = document.getElementById('nav');
const subNav = document.getElementById('sub-nav');
const viewDs = document.getElementById('view-ds');
const viewPalette = document.getElementById('view-palette');
const subnavDs = document.getElementById('subnav-ds');
const subnavPalette = document.getElementById('subnav-palette');
let inPaletteView = false;

function switchView(viewName, pushHistory) {
  const isDs = viewName === 'design-system';
  inPaletteView = !isDs;
  viewDs.hidden = !isDs;
  viewPalette.hidden = isDs;
  subnavDs.style.display = isDs ? '' : 'none';
  subnavPalette.style.display = isDs ? 'none' : '';
  document.querySelectorAll('.nav-view-link').forEach(l => l.classList.toggle('active', l.dataset.view === viewName));
  if (pushHistory !== false) history.pushState({ view: viewName }, '', isDs ? '#design-system' : '#palette');
  window.scrollTo(0, 0);
  if (!isDs) { nav.classList.add('filled'); subNav.classList.add('filled'); }
  else if (window.scrollY <= 20) { nav.classList.remove('filled'); subNav.classList.remove('filled'); }
  requestAnimationFrame(() => updateSubNavIndicator(isDs ? 'ds' : 'palette'));
}

document.querySelectorAll('[data-view]').forEach(el => {
  el.addEventListener('click', e => { e.preventDefault(); switchView(el.dataset.view); });
});
window.addEventListener('popstate', e => {
  switchView(e.state?.view ?? (window.location.hash === '#palette' ? 'palette' : 'design-system'), false);
});
if (window.location.hash === '#palette') switchView('palette', false);

// ── Smart nav ──────────────────────────────────
const cs = getComputedStyle(document.documentElement);
const NAV_H    = parseInt(cs.getPropertyValue('--nav-height'));
const SUBNAV_H = parseInt(cs.getPropertyValue('--subnav-height'));
let lastY = 0;
window.addEventListener('scroll', () => {
  const y = window.scrollY;
  nav.classList.toggle('filled', y > 20 || inPaletteView);
  subNav.classList.toggle('filled', y > 20 || inPaletteView);
  if (y < NAV_H) {
    nav.classList.remove('hidden');
    subNav.classList.remove('hidden');
    document.documentElement.style.setProperty('--scroll-offset', (NAV_H + SUBNAV_H) + 'px');
  } else if (y > lastY + 8) {
    nav.classList.add('hidden');
    subNav.classList.add('hidden');
    document.documentElement.style.setProperty('--scroll-offset', SUBNAV_H + 'px');
  } else if (y < lastY) {
    nav.classList.remove('hidden');
    subNav.classList.remove('hidden');
    document.documentElement.style.setProperty('--scroll-offset', (NAV_H + SUBNAV_H) + 'px');
  }
  lastY = y;
}, { passive: true });

// ── Hamburger ──────────────────────────────────
const hamburger = document.getElementById('hamburger');
const hamburgerIcon = document.getElementById('hamburgerIcon');
const drawer = document.getElementById('mobileDrawer');
hamburger.addEventListener('click', () => {
  const open = drawer.classList.toggle('open');
  hamburger.setAttribute('aria-expanded', open);
  hamburgerIcon.className = open ? 'ti ti-x' : 'ti ti-menu-2';
  document.body.style.overflow = open ? 'hidden' : '';
});
drawer.querySelectorAll('a:not(.drawer-cta)').forEach(a => {
  a.addEventListener('click', () => {
    drawer.classList.remove('open');
    hamburger.setAttribute('aria-expanded', 'false');
    hamburgerIcon.className = 'ti ti-menu-2';
    document.body.style.overflow = '';
  });
});

// ── Sub-nav indicator ──────────────────────────
function updateSubNavIndicator(which) {
  const panel = document.getElementById(which === 'ds' ? 'subnav-ds' : 'subnav-palette');
  const indicator = document.getElementById(which === 'ds' ? 'sub-nav-indicator-ds' : 'sub-nav-indicator-palette');
  if (!panel || !indicator) return;
  const active = panel.querySelector('.sub-nav-link.active') || panel.querySelector('.sub-nav-link');
  if (active) { indicator.style.left = active.offsetLeft + 'px'; indicator.style.width = active.offsetWidth + 'px'; }
}

// ── Reveal animation ───────────────────────────
const revealObs = new IntersectionObserver(entries => {
  entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('is-visible'); revealObs.unobserve(e.target); } });
}, { threshold: 0.1 });
document.querySelectorAll('.reveal').forEach(el => revealObs.observe(el));

// ── Sub-nav: DS section tracking ───────────────
const dsNavObs = new IntersectionObserver(entries => {
  entries.forEach(e => {
    if (e.isIntersecting) {
      document.querySelectorAll('#subnav-ds .sub-nav-link').forEach(l => l.classList.remove('active'));
      const link = document.querySelector(`#subnav-ds a[href="#${e.target.id}"]`);
      if (link) { link.classList.add('active'); updateSubNavIndicator('ds'); }
    }
  });
}, { threshold: 0.3 });
['about', 'foundations', 'components', 'surfaces'].forEach(id => {
  const el = document.getElementById(id); if (el) dsNavObs.observe(el);
});

// ── Sub-nav: Palette section tracking ──────────
const paletteNavObs = new IntersectionObserver(entries => {
  entries.forEach(e => {
    if (e.isIntersecting) {
      document.querySelectorAll('#subnav-palette .sub-nav-link').forEach(l => l.classList.remove('active'));
      const link = document.querySelector(`#subnav-palette a[href="#${e.target.id}"]`);
      if (link) { link.classList.add('active'); updateSubNavIndicator('palette'); }
    }
  });
}, { threshold: 0.3 });
['iron-night', 'birch-storm', 'forest', 'bloom', 'semantic', 'wcag', 'css-vars'].forEach(id => {
  const el = document.getElementById(id); if (el) paletteNavObs.observe(el);
});

// Initialise DS sub-nav first link as active
const firstDsLink = document.querySelector('#subnav-ds .sub-nav-link');
if (firstDsLink) { firstDsLink.classList.add('active'); requestAnimationFrame(() => updateSubNavIndicator('ds')); }

// ── Palette sub-nav: scroll without hash change ─
document.querySelectorAll('#subnav-palette .sub-nav-link').forEach(link => {
  link.addEventListener('click', e => {
    e.preventDefault();
    const id = link.getAttribute('href').slice(1);
    const target = document.getElementById(id);
    if (target) {
      const scrollOffset = parseInt(
        getComputedStyle(document.documentElement).getPropertyValue('--scroll-offset')
      ) || 108;
      window.scrollTo({ top: target.getBoundingClientRect().top + window.scrollY - scrollOffset, behavior: 'smooth' });
    }
  });
});

// ── Palette: copy hex buttons ──────────────────
document.querySelectorAll('.copy-btn[data-copy]').forEach(btn => {
  btn.addEventListener('click', () => {
    navigator.clipboard.writeText(btn.dataset.copy).then(() => {
      btn.textContent = 'copied!'; btn.classList.add('copied');
      setTimeout(() => { btn.textContent = 'copy'; btn.classList.remove('copied'); }, 1500);
    });
  });
});

// ── Palette: copy CSS block ────────────────────
const codeCopyBtn = document.getElementById('codeCopyBtn');
const cssCodeEl = document.getElementById('cssCode');
if (codeCopyBtn && cssCodeEl) {
  codeCopyBtn.addEventListener('click', () => {
    navigator.clipboard.writeText(cssCodeEl.textContent).then(() => {
      codeCopyBtn.textContent = 'Copied!'; codeCopyBtn.classList.add('copied');
      setTimeout(() => { codeCopyBtn.textContent = 'Copy'; codeCopyBtn.classList.remove('copied'); }, 2000);
    });
  });
}
</script>
</body>
</html>
