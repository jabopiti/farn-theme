---
// Standalone page — full landing experience, does not use DocLayout.
// Uses SiteNav for the nav bar (shared with DocLayout); landing-specific
// body layout and scroll behaviour handled below.
import SiteNav from '../components/SiteNav.astro';
import Footer from '../components/Footer.astro';
import FernParallaxBackground from '../components/FernParallaxBackground.astro';
import { groups, links, ctas } from '../data/navigation';
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Farn — Design System</title>
<meta name="description" content="A token-first CSS design system rooted in the forests of northern Germany. Framework-agnostic tokens and component classes for any stack." />
<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="icon" type="image/png" href="/fern_icon.png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/fraunces-latin-normal.woff2" />
<link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/fraunces-latin-italic.woff2" />
<link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/instrument-sans-latin.woff2" />
<link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/jetbrains-mono-latin.woff2" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/dist/tabler-icons.min.css" />
<script is:inline>
  (function() {
    const stored = localStorage.getItem('farn-theme');
    const system = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    document.documentElement.setAttribute('data-theme', stored ?? system);
  })();
</script>
<style is:global>
  @import '../styles/fonts.css';
  @import '../../../tokens/colors.css';
  @import '../../../tokens/typography.css';
  @import '../../../tokens/spacing.css';
  @import '../../../tokens/motion.css';
  @import '../../../tokens/components.css';
  @import '../../../tokens/dark-light.css';
  @import '../../../tokens/component-classes.css';
  @import '../../../tokens/typography-classes.css';
  @import '../../../tokens/layout.css';
  @import '../../../tokens/base.css';
  @import '../styles/site.css';

  html { scroll-padding-top: var(--nav-height); }

  /* ── Section spacing ──────────────────────────────── */
  .landing-section { padding: var(--space-3xl) 0; }

  /* Sections that own a bottom divider need room for it to sit in */
  .landing-section--divider-arc  { position: relative; padding-bottom: calc(var(--space-3xl) + var(--arc-height)); }
  .landing-section--divider-wave { position: relative; padding-bottom: calc(var(--space-3xl) + var(--wave-height)); }
  .landing-section--divider-blob { position: relative; padding-bottom: calc(var(--space-3xl) + var(--blob-height)); }

  /* ── Hero ─────────────────────────────────────────── */
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    position: relative;
    overflow: clip;
    padding-top: var(--space-4xl);
    padding-bottom: calc(var(--space-4xl) + var(--wave-height));
    background: var(--color-bg);
    touch-action: pan-y;
  }
  /* Semantic tokens above resolve to the correct palette per theme automatically */
  .hero-inner {
    position: relative;
    width: 100%;
    max-width: var(--width-content);
    margin: 0 auto;
    padding: 0 var(--space-lg);
    z-index: 40;
  }
  .hero-eyebrow {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: var(--space-md);
    opacity: 0;
    animation: fadeUp 600ms ease-out 100ms forwards;
  }
  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(56px, 9vw, 112px);
    font-weight: 800;
    font-variation-settings: 'opsz' 72;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--color-text);
    margin-bottom: var(--space-lg);
    opacity: 0;
    animation: fadeUp 700ms ease-out 200ms forwards;
  }
  .hero-title em { font-style: italic; color: var(--color-accent); }
  .hero-desc {
    font-size: clamp(16px, 2vw, 20px);
    line-height: 1.65;
    /* Exception: --color-text instead of --color-text-secondary. The hero gradient
       background reduces perceived contrast of the secondary tone in light mode.
       Size hierarchy (56–112px title vs 16–20px body) carries the visual distinction. */
    color: var(--color-text);
    max-width: 52ch;
    margin-bottom: var(--space-xl);
    opacity: 0;
    animation: fadeUp 700ms ease-out 350ms forwards;
  }
  .hero-actions {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
    opacity: 0;
    animation: fadeUp 700ms ease-out 450ms forwards;
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-eyebrow,
    .hero-title,
    .hero-desc,
    .hero-actions { opacity: 1; animation: none; }
  }
  /* ── About ────────────────────────────────────────── */
  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4xl);
    align-items: center;
  }
  @media (max-width: 768px) {
    .about-grid { grid-template-columns: 1fr; gap: var(--space-2xl); }
  }
  .about-text p {
    font-size: var(--text-base);
    line-height: 1.75;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-md);
  }
  .about-text p:last-child { margin-bottom: 0; }
  .about-palettes { display: flex; flex-direction: column; gap: var(--space-sm); }
  .palette-row { display: flex; gap: 4px; }
  .palette-row .swatch {
    height: 40px;
    flex: 1;
    border-radius: var(--radius-sm);
    transition: transform 150ms ease, flex 200ms ease;
  }
  .palette-row .swatch:hover { transform: scaleY(1.15); flex: 2; }
  /* Swatch name overlay (palette section) */
  .swatch-wrap { position: relative; flex: 1; transition: flex 200ms ease; }
  .swatch-wrap:hover { flex: 2; }
  .swatch-wrap .swatch { width: 100%; flex: unset; transition: transform 150ms ease; }
  .swatch-wrap:hover .swatch { transform: scaleY(1.15); }
  .swatch-name {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    text-align: center;
    font-size: 9px; /* hover overlay only — intentionally below token scale */
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: capitalize;
    padding-bottom: 4px;
    color: rgba(255,255,255,0.95);
    text-shadow: 0 1px 3px rgba(0,0,0,0.9);
    opacity: 0;
    transform: translateY(3px);
    transition: opacity var(--duration-fast) var(--ease-out), transform var(--duration-fast) var(--ease-out);
    pointer-events: none;
  }
  .swatch-wrap:hover .swatch-name { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) {
    .swatch-name { transition: opacity 100ms; transform: none; }
  }
  .palette-label {
    font-size: var(--text-2xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-tertiary);
    margin-bottom: 6px;
  }

  /* ── The System ───────────────────────────────────── */
  .system-grid {
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr;
    gap: var(--space-md);
    align-items: center;
  }
  @media (max-width: 768px) {
    .system-grid {
      grid-template-columns: 1fr;
    }
    .system-arrow { display: none; }
  }
  .system-arrow {
    font-size: 24px;
    color: var(--color-text-tertiary);
    text-align: center;
    user-select: none;
  }
  .system-card {
    height: 100%;
  }
  .system-card .card-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }
  .system-icon {
    font-size: 22px;
    color: var(--color-accent);
    margin-bottom: var(--space-xs);
  }
  .system-tier {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-bottom: var(--space-sm);
  }
  .system-tier i { font-size: 22px; color: var(--color-accent); }
  .system-card h3, .get-card h3 {
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: 700;
    font-variation-settings: 'opsz' 16;
    letter-spacing: -0.01em;
    color: var(--color-text);
    margin-bottom: var(--space-xs);
  }
  .system-card p {
    font-size: var(--text-sm);
    line-height: 1.65;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-sm);
  }
  .system-codes {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-top: auto;
  }

  /* ── Palette + Typography ─────────────────────────── */
  .paltype-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4xl);
    align-items: center;
  }
  @media (max-width: 768px) {
    .paltype-grid { grid-template-columns: 1fr; gap: var(--space-2xl); }
  }
  .type-specimen {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }
  .specimen-display {
    font-family: var(--font-display);
    font-size: clamp(80px, 14vw, 160px);
    font-weight: 800;
    font-variation-settings: 'opsz' 144;
    font-style: italic;
    line-height: 0.9;
    letter-spacing: -0.03em;
    color: var(--color-accent);
  }
  .specimen-meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }
  .specimen-row {
    display: flex;
    align-items: baseline;
    gap: var(--space-sm);
  }
  .specimen-name {
    font-size: var(--text-2xs);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-tertiary);
    width: 80px;
    flex-shrink: 0;
  }
  .specimen-sample-body {
    font-size: var(--text-sm);
    line-height: 1;
    color: var(--color-text-secondary);
  }
  .specimen-sample-mono {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
  }

  /* ── Tokens in action ─────────────────────────────── */
  .tokens-demo-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin-bottom: var(--space-xl);
  }
  .tokens-demo-cols {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
  }
  @media (max-width: 640px) {
    .tokens-demo-cols { grid-template-columns: 1fr; }
  }
  .tokens-demo-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }
  .surface-label {
    font-size: var(--text-2xs);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-tertiary);
    margin-bottom: var(--space-xs);
  }
  .demo-card {
    padding: var(--space-lg);
    border-radius: var(--card-radius);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    flex: 1;
  }
  .demo-card h4 {
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: 700;
    font-variation-settings: 'opsz' 16;
    letter-spacing: -0.01em;
    color: var(--color-text);
  }
  .demo-card p {
    font-size: var(--text-xs);
    line-height: 1.55;
    color: var(--color-text-secondary);
    flex: 1;
  }

  /* ── What you get ─────────────────────────────────── */
  .get-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-md);
  }
  .get-icon {
    font-size: 24px;
    color: var(--color-accent);
    margin-bottom: var(--space-sm);
  }
  .get-card p {
    font-size: var(--text-sm);
    line-height: 1.65;
    color: var(--color-text-secondary);
  }

  /* Section CTA row — same flex layout as hero-actions, no entrance animation */
  .section-actions {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
    margin-top: var(--space-lg);
  }

  /* ── Closing CTA ──────────────────────────────────── */
  .cta-section { padding: var(--space-3xl) 0; }
  .cta-section .cta-inner { max-width: var(--width-prose); }

</style>
</head>
<body>

<!-- Nav + mobile drawer (shared with doc pages via SiteNav) -->
<SiteNav {groups} {links} {ctas} />

<main id="main-content">

<!-- ── § 1 Hero ──────────────────────────────────────────────────── -->
<section class="hero" data-fern data-intro="3000" aria-label="Hero">
  <FernParallaxBackground />
  <div class="hero-inner">
    <p class="hero-eyebrow">Sharp · Warm · Intellectual</p>
    <h1 class="hero-title">A design system<br>rooted in northern forests.</h1>
    <p class="hero-desc">Created for a clean and lightweight design. Framework-agnostic tokens and component classes. Zero runtime, zero framework dependency.</p>
    <div class="hero-actions">
      <a href="#about" class="btn btn-p btn-lg"><i class="ti ti-eye"></i> Explore</a>
      <a href="/getting-started" class="btn btn-s btn-lg"><i class="ti ti-book"></i> Get Started</a>
    </div>
  </div>
</section>

<!-- ── § 2 About ──────────────────────────────────────────────────── -->
<section class="landing-section" data-surface="featured" id="about">
  <div class="container">
    <div class="about-grid">
      <div class="about-text">
        <p class="text-label section-eyebrow scroll-reveal">About</p>
        <h2 class="text-h2 section-title scroll-reveal">A design system that knows what it is.</h2>
        <figure class="quote-pull scroll-reveal">
          <p>From the Old Saxon <em>farn</em> — feather-leaf, forest floor, northern ground.</p>
          <figcaption>Etymology</figcaption>
        </figure>
        <p class="scroll-reveal">Farn is built on one conviction: a design system should have a point of view. Not neutral components, but a coherent vocabulary — warm enough to feel human, sharp enough to feel considered. Four token palettes, a two-layer semantic architecture, and component classes with light and dark surface variants.</p>
        <div class="section-actions scroll-reveal">
          <a href="/foundations" class="btn btn-g"><i class="ti ti-books"></i> Explore Foundations</a>
        </div>
      </div>
      <div class="about-palettes scroll-reveal">
        <div class="palette-label">Iron Night</div>
        <div class="palette-row">
          <div class="swatch" style="background:var(--in0-void)" title="void"></div>
          <div class="swatch" style="background:var(--in1-iron)" title="iron"></div>
          <div class="swatch" style="background:var(--in2-slate)" title="slate"></div>
          <div class="swatch" style="background:var(--in3-ash)" title="ash"></div>
        </div>
        <div class="palette-label" style="margin-top:12px">Birch Mist</div>
        <div class="palette-row">
          <div class="swatch" style="background:var(--bm0-sand)" title="sand"></div>
          <div class="swatch" style="background:var(--bm1-mist)" title="mist"></div>
          <div class="swatch" style="background:var(--bm2-birch)" title="birch"></div>
        </div>
        <div class="palette-label" style="margin-top:12px">Forest</div>
        <div class="palette-row">
          <div class="swatch" style="background:var(--fo0-glade)" title="glade"></div>
          <div class="swatch" style="background:var(--fo1-fern)" title="fern"></div>
          <div class="swatch" style="background:var(--fo2-forest)" title="forest"></div>
          <div class="swatch" style="background:var(--fo3-deepwater)" title="deepwater"></div>
        </div>
        <div class="palette-label" style="margin-top:12px">Bloom</div>
        <div class="palette-row">
          <div class="swatch" style="background:var(--bl0-ember)" title="ember"></div>
          <div class="swatch" style="background:var(--bl1-ochre)" title="ochre"></div>
          <div class="swatch" style="background:var(--bl2-grain)" title="grain"></div>
          <div class="swatch" style="background:var(--bl3-moss)" title="moss"></div>
          <div class="swatch" style="background:var(--bl4-heather)" title="heather"></div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ── § 3 The System ─────────────────────────────────────────────── -->
<section class="landing-section landing-section--divider-arc" data-surface="base" id="system">
  <div class="container">
    <p class="text-label section-eyebrow scroll-reveal">Architecture</p>
    <h2 class="text-h2 section-title scroll-reveal">Tokens all the way down.</h2>
    <p class="text-body-lg section-desc scroll-reveal">Three tiers, each building on the last. Swap a palette token and the entire system updates. Components never reference raw colours.</p>

    <div class="section-actions scroll-reveal" style="margin-top:var(--space-lg)">
      <a href="/styles" class="btn btn-g"><i class="ti ti-palette"></i> Browse Styles</a>
    </div>

    <div class="system-grid scroll-reveal" style="margin-top:var(--space-xl)">
      <!-- Tier 1 -->
      <div class="card system-card card-outlined">
        <div class="card-body">
          <div class="system-tier"><i class="ti ti-color-swatch"></i><span class="badge badge-category">Tier 1</span></div>
          <h3>Palette tokens</h3>
          <p>Named colour, spacing, type, and motion values. The raw vocabulary — never referenced by components directly.</p>
          <div class="system-codes">
            <code class="inline-code">--fo1-fern</code>
            <code class="inline-code">--in0-void</code>
            <code class="inline-code">--space-md</code>
          </div>
        </div>
      </div>

      <div class="system-arrow" aria-hidden="true">→</div>

      <!-- Tier 2 -->
      <div class="card system-card card-outlined">
        <div class="card-body">
          <div class="system-tier"><i class="ti ti-layers-subtract"></i><span class="badge badge-category">Tier 2</span></div>
          <h3>Semantic tokens</h3>
          <p>Purpose-named aliases that resolve per theme and surface. Light, dark, and surface overrides cascade automatically.</p>
          <div class="system-codes">
            <code class="inline-code">--color-bg</code>
            <code class="inline-code">--color-accent</code>
            <code class="inline-code">--color-text</code>
          </div>
        </div>
      </div>

      <div class="system-arrow" aria-hidden="true">→</div>

      <!-- Tier 3 -->
      <div class="card system-card card-outlined">
        <div class="card-body">
          <div class="system-tier"><i class="ti ti-puzzle"></i><span class="badge badge-category">Tier 3</span></div>
          <h3>Component tokens &amp; classes</h3>
          <p>Opt-in CSS classes built on top of semantic tokens. Override at the component level without touching the palette.</p>
          <div class="system-codes">
            <code class="inline-code">.btn.btn-p</code>
            <code class="inline-code">.card</code>
            <code class="inline-code">.badge</code>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Arc divider — transitions into the layer surface below -->
  <div class="section-arc" style="--color-section-next: var(--color-bg-panel)" aria-hidden="true">
    <svg viewBox="0 0 1200 80" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M0,80 Q600,0 1200,80 Z" fill="var(--color-section-next)"/>
    </svg>
  </div>
</section>

<!-- ── § 4 Palette + Typography ───────────────────────────────────── -->
<section class="landing-section landing-section--divider-wave" data-surface="layer" id="palette-type">
  <div class="container">
    <div class="paltype-grid">
      <div class="scroll-reveal">
        <p class="text-label section-eyebrow">Palette</p>
        <h2 class="text-h2 section-title">Four palettes.<br>One vocabulary.</h2>
        <div class="about-palettes" style="margin-top:var(--space-lg)">
          <div class="palette-label">Iron Night</div>
          <div class="palette-row">
            <div class="swatch-wrap"><div class="swatch" style="background:var(--in0-void)"></div><span class="swatch-name">Void</span></div>
            <div class="swatch-wrap"><div class="swatch" style="background:var(--in1-iron)"></div><span class="swatch-name">Iron</span></div>
            <div class="swatch-wrap"><div class="swatch" style="background:var(--in2-slate)"></div><span class="swatch-name">Slate</span></div>
            <div class="swatch-wrap"><div class="swatch" style="background:var(--in3-ash)"></div><span class="swatch-name">Ash</span></div>
          </div>
          <div class="palette-label" style="margin-top:12px">Birch Mist</div>
          <div class="palette-row">
            <div class="swatch-wrap"><div class="swatch" style="background:var(--bm0-sand)"></div><span class="swatch-name">Sand</span></div>
            <div class="swatch-wrap"><div class="swatch" style="background:var(--bm1-mist)"></div><span class="swatch-name">Mist</span></div>
            <div class="swatch-wrap"><div class="swatch" style="background:var(--bm2-birch)"></div><span class="swatch-name">Birch</span></div>
          </div>
          <div class="palette-label" style="margin-top:12px">Forest</div>
          <div class="palette-row">
            <div class="swatch-wrap"><div class="swatch" style="background:var(--fo0-glade)"></div><span class="swatch-name">Glade</span></div>
            <div class="swatch-wrap"><div class="swatch" style="background:var(--fo1-fern)"></div><span class="swatch-name">Fern</span></div>
            <div class="swatch-wrap"><div class="swatch" style="background:var(--fo2-forest)"></div><span class="swatch-name">Forest</span></div>
            <div class="swatch-wrap"><div class="swatch" style="background:var(--fo3-deepwater)"></div><span class="swatch-name">Deepwater</span></div>
          </div>
          <div class="palette-label" style="margin-top:12px">Bloom</div>
          <div class="palette-row">
            <div class="swatch-wrap"><div class="swatch" style="background:var(--bl0-ember)"></div><span class="swatch-name">Ember</span></div>
            <div class="swatch-wrap"><div class="swatch" style="background:var(--bl1-ochre)"></div><span class="swatch-name">Ochre</span></div>
            <div class="swatch-wrap"><div class="swatch" style="background:var(--bl2-grain)"></div><span class="swatch-name">Grain</span></div>
            <div class="swatch-wrap"><div class="swatch" style="background:var(--bl3-moss)"></div><span class="swatch-name">Moss</span></div>
            <div class="swatch-wrap"><div class="swatch" style="background:var(--bl4-heather)"></div><span class="swatch-name">Heather</span></div>
          </div>
        </div>
        <div class="section-actions" style="margin-top:var(--space-lg)">
          <a href="/styles/color" class="btn btn-g"><i class="ti ti-color-filter"></i> Explore Colors</a>
        </div>
      </div>

      <div class="type-specimen scroll-reveal">
