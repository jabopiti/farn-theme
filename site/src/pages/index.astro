---
// Standalone page — full landing experience, does not use DocLayout.
// Uses SiteNav for the nav bar (shared with DocLayout); landing-specific
// body layout and scroll behaviour handled below.
import SiteNav from '../components/SiteNav.astro';
import Footer from '../components/Footer.astro';
import FernMultiplaneHero from '../components/FernMultiplaneHero.astro';
import { groups, links, ctas } from '../data/navigation';
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Farn — Design System</title>
<meta name="description" content="A token-first CSS design system rooted in the forests of northern Germany. Framework-agnostic tokens and component classes for any stack." />
<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="icon" type="image/png" href="/fern_icon.png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..900;1,9..144,300..900&family=Instrument+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/dist/tabler-icons.min.css" />
<script is:inline>
  (function() {
    const stored = localStorage.getItem('farn-theme');
    const system = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    document.documentElement.setAttribute('data-theme', stored ?? system);
  })();
</script>
<style is:global>
  @import '../../../tokens/colors.css';
  @import '../../../tokens/spacing.css';
  @import '../../../tokens/motion.css';
  @import '../../../tokens/dark-light.css';
  @import '../../../tokens/components.css';
  @import '../../../tokens/component-classes.css';
  @import '../../../tokens/typography-classes.css';
  @import '../../../tokens/base.css';
  @import '../styles/site.css';

  /* ── Section spacing ──────────────────────────────── */
  .landing-section { padding: var(--space-3xl) 0; }

  /* ── Keyframes ────────────────────────────────────── */
  @keyframes fadeIn {
    from { opacity: 0; }
    to   { opacity: 1; }
  }
  @keyframes swatchSlideIn {
    from { opacity: 0; transform: translateX(12px); }
    to   { opacity: 1; transform: translateX(0); }
  }
  @media (prefers-reduced-motion: no-preference) {
    @keyframes paletteFloat {
      0%, 100% { transform: translateY(-50%); }
      50%       { transform: translateY(calc(-50% - 5px)); }
    }
  }

  /* ── Hero: make room for the wave divider at the bottom ── */
  .farn-hero--multiplane { padding-bottom: var(--wave-height); }

  /* ── Hero actions (in FernMultiplaneHero slot) ───── */
  .hero-actions {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }

  /* ── Palette strip (in FernMultiplaneHero overlay slot) ── */
  .hero-palette-strip {
    position: absolute;
    right: var(--space-lg);
    top: 50%;
    transform: translateY(-50%);
    z-index: 20;
    display: flex;
    flex-direction: column;
    gap: 3px;
    opacity: 0;
    animation: fadeIn 800ms ease-out 600ms forwards;
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero-palette-strip.is-visible {
      animation: paletteFloat 8s ease-in-out infinite;
    }
  }
  @media (max-width: 900px) { .hero-palette-strip { display: none; } }
  .palette-swatch {
    width: 8px;
    border-radius: var(--radius-sm);
    opacity: 0;
    /* --i set inline; staggered entrance */
    animation: swatchSlideIn 400ms ease-out calc(650ms + var(--i, 0) * 25ms) forwards;
  }

  /* ── About ────────────────────────────────────────── */
  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4xl);
    align-items: center;
  }
  @media (max-width: 768px) {
    .about-grid { grid-template-columns: 1fr; gap: var(--space-2xl); }
  }
  .about-text p {
    font-size: 16px;
    line-height: 1.75;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-md);
  }
  .about-text p:last-child { margin-bottom: 0; }
  .about-etymology {
    font-family: var(--font-display);
    font-size: 17px;
    font-variation-settings: 'opsz' 18;
    font-style: italic;
    color: var(--color-text-tertiary);
    margin-bottom: var(--space-md);
  }
  .about-palettes { display: flex; flex-direction: column; gap: var(--space-sm); }
  .palette-row { display: flex; gap: 4px; }
  .palette-row .swatch {
    height: 40px;
    flex: 1;
    border-radius: var(--radius-sm);
    transition: transform 150ms ease, flex 200ms ease;
  }
  .palette-row .swatch:hover { transform: scaleY(1.15); flex: 2; }
  .palette-label {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-tertiary);
    margin-bottom: 6px;
  }

  /* ── The System ───────────────────────────────────── */
  .system-grid {
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr;
    gap: var(--space-md);
    align-items: center;
  }
  @media (max-width: 768px) {
    .system-grid {
      grid-template-columns: 1fr;
    }
    .system-arrow { display: none; }
  }
  .system-arrow {
    font-size: 24px;
    color: var(--color-text-tertiary);
    text-align: center;
    user-select: none;
  }
  .system-card {
    height: 100%;
  }
  .system-card .card-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }
  .system-icon {
    font-size: 22px;
    color: var(--color-accent);
    margin-bottom: var(--space-xs);
  }
  .system-card h3 {
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 700;
    font-variation-settings: 'opsz' 18;
    letter-spacing: -0.01em;
    color: var(--color-text);
    margin-bottom: var(--space-xs);
  }
  .system-card p {
    font-size: 14px;
    line-height: 1.65;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-sm);
  }
  .system-codes {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-top: auto;
  }

  /* ── Palette + Typography ─────────────────────────── */
  .paltype-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4xl);
    align-items: center;
  }
  @media (max-width: 768px) {
    .paltype-grid { grid-template-columns: 1fr; gap: var(--space-2xl); }
  }
  .type-specimen {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }
  .specimen-display {
    font-family: var(--font-display);
    font-size: clamp(80px, 14vw, 160px);
    font-weight: 800;
    font-variation-settings: 'opsz' 144;
    font-style: italic;
    line-height: 0.9;
    letter-spacing: -0.03em;
    color: var(--color-accent);
  }
  .specimen-meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }
  .specimen-row {
    display: flex;
    align-items: baseline;
    gap: var(--space-sm);
  }
  .specimen-name {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-tertiary);
    width: 80px;
    flex-shrink: 0;
  }
  .specimen-sample-body {
    font-size: 15px;
    line-height: 1;
    color: var(--color-text-secondary);
  }
  .specimen-sample-mono {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--color-text-secondary);
  }

  /* ── Tokens in action ─────────────────────────────── */
  .tokens-demo-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin-bottom: var(--space-xl);
  }
  .tokens-demo-cols {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
  }
  @media (max-width: 640px) {
    .tokens-demo-cols { grid-template-columns: 1fr; }
  }
  .tokens-demo-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }
  .surface-label {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-tertiary);
    margin-bottom: var(--space-xs);
  }
  .demo-card {
    padding: var(--space-lg);
    border-radius: var(--card-radius);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    flex: 1;
  }
  .demo-card h4 {
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 700;
    font-variation-settings: 'opsz' 16;
    letter-spacing: -0.01em;
    color: var(--color-text);
  }
  .demo-card p {
    font-size: 13px;
    line-height: 1.55;
    color: var(--color-text-secondary);
    flex: 1;
  }

  /* ── What you get ─────────────────────────────────── */
  .get-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-md);
  }
  .get-icon {
    font-size: 24px;
    color: var(--color-accent);
    margin-bottom: var(--space-sm);
  }
  .get-card h3 {
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 700;
    font-variation-settings: 'opsz' 18;
    letter-spacing: -0.01em;
    color: var(--color-text);
    margin-bottom: var(--space-xs);
  }
  .get-card p {
    font-size: 14px;
    line-height: 1.65;
    color: var(--color-text-secondary);
  }
  .get-card .badge {
    margin-bottom: var(--space-sm);
  }

  /* Section CTA row — same flex layout as hero-actions, no entrance animation */
  .section-actions {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
    margin-top: var(--space-lg);
  }

  /* ── Closing CTA ──────────────────────────────────── */
  .cta-section { padding: var(--space-3xl) 0; }
  .cta-section .cta-inner { max-width: var(--width-prose); }

</style>
</head>
<body>

<!-- Nav + mobile drawer (shared with doc pages via SiteNav) -->
<SiteNav {groups} {links} {ctas} />

<!-- ── § 1 Hero ──────────────────────────────────────────────────── -->
<FernMultiplaneHero
  eyebrow="Design System"
  title="Sharp.<br /><em>Warm.</em><br />Intellectual."
  lede="A token-first CSS design system rooted in the forests of northern Germany. Framework-agnostic tokens and component classes. Zero runtime, zero framework dependency."
>
  <div class="hero-actions">
    <a href="/demo" class="btn btn-p btn-lg"><i class="ti ti-eye"></i> Explore the demo</a>
    <a href="/getting-started" class="btn btn-g btn-lg"><i class="ti ti-book"></i> Get Started</a>
  </div>
  <!-- Overlay slot: palette strip + wave, positioned relative to the section -->
  <div slot="overlay" class="hero-palette-strip" aria-hidden="true" id="palette-strip">
    <div class="palette-swatch" style="background:#0D1117;height:28px;--i:0"></div>
    <div class="palette-swatch" style="background:#374151;height:28px;--i:1"></div>
    <div class="palette-swatch" style="background:#4B5563;height:28px;--i:2"></div>
    <div class="palette-swatch" style="background:#6B7280;height:28px;--i:3"></div>
    <div class="palette-swatch" style="background:#D5D2C7;height:28px;--i:4"></div>
    <div class="palette-swatch" style="background:#E9E6DC;height:28px;--i:5"></div>
    <div class="palette-swatch" style="background:#F7F6F3;height:28px;--i:6"></div>
    <div class="palette-swatch" style="background:#5C9E86;height:28px;--i:7"></div>
    <div class="palette-swatch" style="background:#3E7A62;height:28px;--i:8"></div>
    <div class="palette-swatch" style="background:#2D5E4A;height:28px;--i:9"></div>
    <div class="palette-swatch" style="background:#254D5A;height:28px;--i:10"></div>
    <div class="palette-swatch" style="background:#C5414C;height:28px;--i:11"></div>
    <div class="palette-swatch" style="background:#AB5A2B;height:28px;--i:12"></div>
    <div class="palette-swatch" style="background:#8D6B20;height:28px;--i:13"></div>
    <div class="palette-swatch" style="background:#567A37;height:28px;--i:14"></div>
    <div class="palette-swatch" style="background:#885DB4;height:28px;--i:15"></div>
  </div>
  <div slot="overlay" class="section-wave" data-scroll-reveal aria-hidden="true">
    <svg viewBox="0 0 1200 80" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M0,40 C200,80 400,0 600,40 C800,80 1000,0 1200,40 L1200,80 L0,80 Z" fill="#1a2332" opacity="0.6"/>
      <path d="M0,55 C200,15 400,75 600,45 C800,15 1000,65 1200,35 L1200,80 L0,80 Z" fill="#0D1117"/>
    </svg>
  </div>
</FernMultiplaneHero>

<!-- ── § 2 About ──────────────────────────────────────────────────── -->
<section class="landing-section" data-theme="dark" id="about">
  <div class="container">
    <div class="about-grid">
      <div class="about-text">
        <p class="section-eyebrow scroll-reveal">About</p>
        <h2 class="section-title scroll-reveal">A design system that knows what it is.</h2>
        <p class="about-etymology scroll-reveal">From the Old Saxon <em>farn</em> — feather-leaf, forest floor, northern ground.</p>
        <p class="scroll-reveal">Farn is built on one conviction: a design system should have a point of view. Not neutral components, but a coherent vocabulary — warm enough to feel human, sharp enough to feel considered. Four token palettes, a two-layer semantic architecture, and component classes with light and dark surface variants.</p>
        <div class="section-actions scroll-reveal">
          <a href="/foundations" class="btn btn-g"><i class="ti ti-books"></i> Explore Foundations</a>
        </div>
      </div>
      <div class="about-palettes scroll-reveal">
        <div class="palette-label">Iron Night</div>
        <div class="palette-row">
          <div class="swatch" style="background:#0D1117" title="void"></div>
          <div class="swatch" style="background:#374151" title="iron"></div>
          <div class="swatch" style="background:#4B5563" title="slate"></div>
          <div class="swatch" style="background:#6B7280" title="ash"></div>
        </div>
        <div class="palette-label" style="margin-top:12px">Birch Mist</div>
        <div class="palette-row">
          <div class="swatch" style="background:#D5D2C7" title="sand"></div>
          <div class="swatch" style="background:#E9E6DC" title="mist"></div>
          <div class="swatch" style="background:#F7F6F3" title="birch"></div>
        </div>
        <div class="palette-label" style="margin-top:12px">Forest</div>
        <div class="palette-row">
          <div class="swatch" style="background:#5C9E86" title="sage"></div>
          <div class="swatch" style="background:#3E7A62" title="fern"></div>
          <div class="swatch" style="background:#2D5E4A" title="forest"></div>
          <div class="swatch" style="background:#254D5A" title="deepwater"></div>
        </div>
        <div class="palette-label" style="margin-top:12px">Bloom</div>
        <div class="palette-row">
          <div class="swatch" style="background:#C5414C" title="ember"></div>
          <div class="swatch" style="background:#AB5A2B" title="ochre"></div>
          <div class="swatch" style="background:#8D6B20" title="grain"></div>
          <div class="swatch" style="background:#567A37" title="moss"></div>
          <div class="swatch" style="background:#885DB4" title="heather"></div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ── § 3 The System ─────────────────────────────────────────────── -->
<section class="landing-section" id="system">
  <div class="container">
    <p class="section-eyebrow scroll-reveal">Architecture</p>
    <h2 class="section-title scroll-reveal">Tokens all the way down.</h2>
    <p class="section-desc scroll-reveal">Three tiers, each building on the last. Swap a palette token and the entire system updates. Components never reference raw colours.</p>

    <div class="system-grid scroll-reveal" style="margin-top:var(--space-2xl)">
      <!-- Tier 1 -->
      <div class="card system-card card-outlined">
        <div class="card-body">
          <span class="badge badge-category">Tier 1</span>
          <div class="system-icon"><i class="ti ti-color-swatch"></i></div>
          <h3>Palette tokens</h3>
          <p>Named colour, spacing, type, and motion values. The raw vocabulary — never referenced by components directly.</p>
          <div class="system-codes">
            <code class="inline-code">--fo1-fern</code>
            <code class="inline-code">--in0-void</code>
            <code class="inline-code">--space-md</code>
          </div>
        </div>
      </div>

      <div class="system-arrow" aria-hidden="true">→</div>

      <!-- Tier 2 -->
      <div class="card system-card card-outlined">
        <div class="card-body">
          <span class="badge badge-general">Tier 2</span>
          <div class="system-icon"><i class="ti ti-layers-subtract"></i></div>
          <h3>Semantic tokens</h3>
          <p>Purpose-named aliases that resolve per theme and surface. Light, dark, and surface overrides cascade automatically.</p>
          <div class="system-codes">
            <code class="inline-code">--color-bg</code>
            <code class="inline-code">--color-accent</code>
            <code class="inline-code">--color-text</code>
          </div>
        </div>
      </div>

      <div class="system-arrow" aria-hidden="true">→</div>

      <!-- Tier 3 -->
      <div class="card system-card card-outlined">
        <div class="card-body">
          <span class="badge badge-beta">Tier 3</span>
          <div class="system-icon"><i class="ti ti-puzzle"></i></div>
          <h3>Component tokens &amp; classes</h3>
          <p>Opt-in CSS classes built on top of semantic tokens. Override at the component level without touching the palette.</p>
          <div class="system-codes">
            <code class="inline-code">.btn.btn-p</code>
            <code class="inline-code">.card</code>
            <code class="inline-code">.badge</code>
          </div>
        </div>
      </div>
    </div>

    <div class="section-actions scroll-reveal" style="margin-top:var(--space-xl)">
      <a href="/styles" class="btn btn-g"><i class="ti ti-palette"></i> Browse Styles</a>
    </div>
  </div>
</section>

<!-- ── § 4 Palette + Typography ───────────────────────────────────── -->
<section class="landing-section" data-surface="layer" id="palette-type">
  <div class="container">
    <div class="paltype-grid">
      <div class="scroll-reveal">
        <p class="section-eyebrow">Palette</p>
        <h2 class="section-title">Four palettes.<br>One vocabulary.</h2>
        <div class="about-palettes" style="margin-top:var(--space-lg)">
          <div class="palette-label">Iron Night</div>
          <div class="palette-row">
            <div class="swatch" style="background:#0D1117" title="void"></div>
            <div class="swatch" style="background:#374151" title="iron"></div>
            <div class="swatch" style="background:#4B5563" title="slate"></div>
            <div class="swatch" style="background:#6B7280" title="ash"></div>
          </div>
          <div class="palette-label" style="margin-top:12px">Birch Mist</div>
          <div class="palette-row">
            <div class="swatch" style="background:#D5D2C7" title="sand"></div>
            <div class="swatch" style="background:#E9E6DC" title="mist"></div>
            <div class="swatch" style="background:#F7F6F3" title="birch"></div>
          </div>
          <div class="palette-label" style="margin-top:12px">Forest</div>
          <div class="palette-row">
            <div class="swatch" style="background:#5C9E86" title="sage"></div>
            <div class="swatch" style="background:#3E7A62" title="fern"></div>
            <div class="swatch" style="background:#2D5E4A" title="forest"></div>
            <div class="swatch" style="background:#254D5A" title="deepwater"></div>
          </div>
          <div class="palette-label" style="margin-top:12px">Bloom</div>
          <div class="palette-row">
            <div class="swatch" style="background:#C5414C" title="ember"></div>
            <div class="swatch" style="background:#AB5A2B" title="ochre"></div>
            <div class="swatch" style="background:#8D6B20" title="grain"></div>
            <div class="swatch" style="background:#567A37" title="moss"></div>
            <div class="swatch" style="background:#885DB4" title="heather"></div>
          </div>
        </div>
        <div class="section-actions" style="margin-top:var(--space-lg)">
          <a href="/styles/color" class="btn btn-g"><i class="ti ti-color-filter"></i> Explore Colors</a>
        </div>
      </div>

      <div class="type-specimen scroll-reveal">
        <div class="specimen-display">Farn.</div>
        <div class="specimen-meta">
          <div class="specimen-row">
            <span class="specimen-name">Display</span>
            <span style="font-family:var(--font-display);font-size:15px;font-variation-settings:'opsz' 15;color:var(--color-text-secondary)">Fraunces — variable, optical size</span>
          </div>
          <div class="specimen-row">
            <span class="specimen-name">Body</span>
            <span class="specimen-sample-body">Instrument Sans — humanist, geometric</span>
          </div>
          <div class="specimen-row">
            <span class="specimen-name">Mono</span>
            <span class="specimen-sample-mono">JetBrains Mono — code, data</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ── § 5 Tokens in action ───────────────────────────────────────── -->
<section class="landing-section" id="tokens-demo" data-theme="light">
  <div class="container">
    <div class="tokens-demo-header">
      <div>
        <p class="section-eyebrow">The token story</p>
        <h2 class="section-title" style="margin-bottom:0">One component. Every surface.</h2>
      </div>
      <button class="btn btn-g" id="demo-theme-toggle" aria-label="Toggle demo theme">
        <i class="ti ti-moon"></i> Switch to Dark
      </button>
    </div>
    <p class="section-desc scroll-reveal" style="margin-bottom:var(--space-xl)">Toggle the theme — tokens resolve automatically. The card, badge, and button below share no hardcoded colours.</p>

    <div class="tokens-demo-cols">
      <div class="tokens-demo-col">
        <p class="surface-label">Base</p>
        <div class="demo-card" data-surface="base">
          <span class="badge badge-beta">Beta</span>
          <h4>Composable layout</h4>
