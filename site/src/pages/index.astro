<script is:inline>
// Smart nav: transparent overlay over hero, fills + hides on scroll
(function () {
  const nav = document.getElementById('nav');
  const NAV_H = parseInt(getComputedStyle(document.documentElement).getPropertyValue('--nav-height'));
  let lastY = 0;
  window.addEventListener('scroll', () => {
    const y = window.scrollY;
    nav.classList.toggle('filled', y > 20);
    if (y < NAV_H) {
      nav.classList.remove('hidden');
    } else if (y > lastY + 8) {
      nav.classList.add('hidden');
    } else if (y < lastY) {
      nav.classList.remove('hidden');
    }
    lastY = y;
  }, { passive: true });
})();
</script>
