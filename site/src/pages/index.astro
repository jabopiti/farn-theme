<!-- Smart nav: transparent overlay over hero, fills + hides on scroll -->
<script is:inline>
(function () {
  const nav = document.getElementById('nav');
  const NAV_H = parseInt(getComputedStyle(document.documentElement).getPropertyValue('--nav-height'));
  let lastY = 0;
  window.addEventListener('scroll', () => {
    const y = window.scrollY;
    nav.classList.toggle('filled', y > 20);
    if (y < NAV_H) {
      nav.classList.remove('hidden');
    } else if (y > lastY + 8) {
      nav.classList.add('hidden');
    } else if (y < lastY) {
      nav.classList.remove('hidden');
    }
    lastY = y;
  }, { passive: true });
})();
</script>

<!-- Palette strip: trigger float animation after entrance completes -->
<script is:inline>
(function () {
  const strip = document.getElementById('palette-strip');
  if (!strip) return;
  // After the last swatch finishes entrance (650ms base + 15 * 25ms = ~1025ms total)
  setTimeout(() => strip.classList.add('is-visible'), 1100);
})();
</script>

<!-- Demo theme toggle (§5 — scoped to #tokens-demo only) -->
<script is:inline>
(function () {
  const section = document.getElementById('tokens-demo');
  const btn     = document.getElementById('demo-theme-toggle');
  if (!section || !btn) return;
  btn.addEventListener('click', () => {
    const isDark = section.getAttribute('data-theme') === 'dark';
    section.setAttribute('data-theme', isDark ? 'light' : 'dark');
    btn.innerHTML = isDark
      ? '<i class="ti ti-moon"></i> Switch to Dark'
      : '<i class="ti ti-sun"></i> Switch to Light';
  });
})();
</script>

