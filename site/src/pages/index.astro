<!-- Demo theme toggle (§5 — toggles global page theme; nav fill/autohide/theme-icon sync is handled by nav.js) -->
<script>
  import { syncNavThemeIcon } from '../scripts/nav.js';

  const btn = document.getElementById('demo-theme-toggle');
  if (btn) {
    const syncBtn = () => {
      const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
      btn.innerHTML = isDark
        ? '<i class="ti ti-sun"></i> Switch to Light'
        : '<i class="ti ti-moon"></i> Switch to Dark';
    };
    syncBtn();
    btn.addEventListener('click', () => {
      const html = document.documentElement;
      const next = html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
      html.setAttribute('data-theme', next);
      localStorage.setItem('farn-theme', next);
      syncBtn();
      syncNavThemeIcon();
    });
  }
</script>

