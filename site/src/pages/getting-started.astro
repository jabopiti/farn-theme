---

<DocLayout title="Getting Started" description="Install Farn and set up dark/light mode in your project">
  <nav slot="subnav" class="sub-nav filled" id="sub-nav-gs" aria-label="Section navigation">
    <div class="sub-nav-inner">
      <a href="#cdn-install" class="sub-nav-link">Install</a>
      <a href="#what-gets-loaded" class="sub-nav-link">Layers</a>
      <a href="#load-fonts" class="sub-nav-link">Fonts</a>
      <a href="#fowt" class="sub-nav-link">FOWT</a>
      <a href="#dark-light-mode" class="sub-nav-link">Theming</a>
      <a href="#surface-overrides" class="sub-nav-link">Surfaces</a>
      <a href="#using-tokens" class="sub-nav-link">Tokens</a>
      <a href="#fraunces-headings" class="sub-nav-link">Fraunces</a>
