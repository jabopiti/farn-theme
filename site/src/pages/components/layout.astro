.hairline        &#123; border-top: 1px solid var(--color-border-subtle); margin: var(--space-sm) 0; &#125;
.section-divider &#123; border-top: 1px solid var(--color-border);        margin: var(--space-md) 0; &#125;
.decorative      &#123; border-top: 2px solid var(--color-accent);        width: 32px; margin: var(--space-md) 0; &#125;</code></pre>

